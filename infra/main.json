              "apiVersion": "2022-09-01",
              "name": "[format('{0}/{1}', parameters('name'), 'functionappsettings')]",
              "kind": "functionappsettings",
              "properties": {
                "STORAGE_MODE": "table",
                "STORAGE_ACCOUNT_NAME": "[parameters('storageAccountName')]",
                "STORAGE_CONNECTION_STRING": "[parameters('storageConnectionString')]",
                "GLOBAL_ADMIN_EMAILS": "[parameters('globalAdminEmails')]",
